{
  "name": "pokedex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "db:generate": "cd database && drizzle-kit generate",
    "db:migrate": "cd database && drizzle-kit migrate",
    "scrapeSerebii": "tsx scripts/scrapeSerebii.ts",
    "scrapeDescriptions": "tsx scripts/scrapeDescriptions.ts",
    "setGenerations": "tsx scripts/setGenerations.ts",
    "scrapeVariants": "tsx scripts/scrapeVariants.ts",
    "scrapeEvolutions": "tsx scripts/scrapePokemonDBEvolutions.ts",
    "downloadMainImages": "tsx scripts/downloadMainImages.ts",
    "downloadPokemonNameImages": "tsx scripts/downloadPokemonNameImages.ts",
    "downloadAnimeCries": "tsx scripts/downloadAnimeCries.ts",
    "scrapePronunciations": "tsx scripts/scrapePronunciations.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/puppeteer": "^5.4.7",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "puppeteer": "^25.11.0",
    "tsx": "^4.23.13",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "main": "dist-electron/main.js"
}
